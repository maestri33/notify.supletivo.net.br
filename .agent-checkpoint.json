{
  "projectId": "notify.supletivo.net.br",
  "hindsightBank": "coding-agent::notify.supletivo.net.br",
  "rules": {
    "brandCheck": {
      "enabled": true,
      "forbiddenTerms": ["v7m", "maestri.group"]
    },
    "language": {
      "code": "en-US",
      "backendEndpoints": {
        "enforcePrefix": "/api/v1/"
      }
    },
    "architecture": {
      "cloudflareFirst": true,
      "disallowedPackages": [
        "boto3",
        "botocore",
        "google-cloud-storage"
      ]
    }
  }
}
